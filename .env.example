# Site Configuration
NEXT_PUBLIC_SITE_URL=https://montessori-ksa.com

# Legacy Odoo platform
# Authentication, parent portal, and management tools remain hosted there.
NEXT_PUBLIC_ODOO_URL=https://odoo.montessori-ksa.com

# Email Service (Resend.com)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Contact Form Configuration
CONTACT_EMAIL_FROM=noreply@montessori-ksa.com
CONTACT_EMAIL_TO=info@montessori-ksa.com

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Social Media Links
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your_handle
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your_handle
NEXT_PUBLIC_SNAPCHAT_URL=https://snapchat.com/add/your_handle
NEXT_PUBLIC_WHATSAPP_NUMBER=+966XXXXXXXXX

# Phone Number
NEXT_PUBLIC_PHONE=+966 XX XXX XXXX

# Security
# In production, set these to appropriate values
NODE_ENV=production
