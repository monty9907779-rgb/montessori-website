// Database utility using localStorage for persistence
// Can be swapped for a real backend (Firebase/Supabase) later

const DB_KEYS = {
  STUDENTS: 'montessori_students',
  PAYMENTS: 'montessori_payments',
  CLASSES: 'montessori_classes',
  USERS: 'montessori_users',
  TEACHERS: 'montessori_teachers',
  REGISTRATIONS: 'montessori_registrations',
  GALLERY: 'montessori_gallery',
  ATTENDANCE: 'montessori_attendance',
  LOCATION: 'montessori_location',
  SETTINGS: 'montessori_settings',
};

// ─── Helpers ───────────────────────────────────────────────────────────────
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2);

const read = (key) => {
  try {
    return JSON.parse(localStorage.getItem(key)) || [];
  } catch {
    return [];
  }
};

const write = (key, data) => {
  localStorage.setItem(key, JSON.stringify(data));
};

// ─── Users / Auth ───────────────────────────────────────────────────────────
export const getUsers = () => read(DB_KEYS.USERS);
export const getUser = (email) => getUsers().find(u => u.email === email);
export const addUser = (user) => {
  const users = getUsers();
  const newUser = { ...user, id: uid() };
  write(DB_KEYS.USERS, [...users, newUser]);
  return newUser;
};
export const updateUser = (id, updates) => {
  write(DB_KEYS.USERS, getUsers().map(u => u.id === id ? { ...u, ...updates } : u));
};
export const deleteUser = (id) => {
  write(DB_KEYS.USERS, getUsers().filter(u => u.id !== id));
};
export const authenticateUser = (email, password) => {
  const user = getUser(email);
  if (!user || user.password !== password) return null;
  return { ...user, password: undefined };
};

// ─── Attendance ────────────────────────────────────────────────────────────
export const getAttendance = () => read(DB_KEYS.ATTENDANCE);
export const getAttendanceForDate = (date) => read(DB_KEYS.ATTENDANCE).filter(a => a.date === date);
export const getStudentAttendance = (studentId) => read(DB_KEYS.ATTENDANCE).filter(a => a.studentId === studentId);
export const markAttendance = (studentId, date, status, notes = '') => {
  const records = read(DB_KEYS.ATTENDANCE);
  const existing = records.findIndex(a => a.studentId === studentId && a.date === date);
  if (existing >= 0) {
    records[existing] = { ...records[existing], status, notes };
    write(DB_KEYS.ATTENDANCE, records);
    return records[existing];
  }
  const newRecord = { id: uid(), studentId, date, status, notes };
  write(DB_KEYS.ATTENDANCE, [...records, newRecord]);
  return newRecord;
};
export const getAttendanceReport = (studentId) => {
  const records = getStudentAttendance(studentId);
  const total = records.length;
  const present = records.filter(r => r.status === 'present').length;
  const absent = records.filter(r => r.status === 'absent').length;
  const excused = records.filter(r => r.status === 'excused').length;
  return { total, present, absent, excused, rate: total ? Math.round((present / total) * 100) : 0 };
};

