// Approve registration → move to students
export const approveRegistration = (regId, classId, monthlyFee) => {
  const reg = read(DB_KEYS.REGISTRATIONS).find(r => r.id === regId);
  if (!reg) return null;
  const newStudent = addStudent({
    name: reg.childName,
    classId,
    enrollDate: new Date().toISOString().slice(0, 10),
    parentName: reg.parentName,
    parentPhone: reg.parentPhone,
    parentEmail: reg.parentEmail,
    status: 'active',
  });
  const month = new Date().toISOString().slice(0, 7);
  addPayment({
    studentId: newStudent.id,
    month,
    amount: monthlyFee || 0,
    status: 'pending',
    paidDate: null,
    dueDate: `${month}-01`,
    method: null,
    notes: 'From public registration',
  });
  deleteRegistration(regId);
  return newStudent;
};

