export const generateMonthlyInvoices = () => {
  const students = getStudents().filter(s => s.status === 'active');
  const classes = getClasses();
  const payments = getPayments();
  const currentMonth = new Date().toISOString().slice(0, 7);

  students.forEach(student => {
    const exists = payments.find(p => p.studentId === student.id && p.month === currentMonth);
    if (!exists) {
      const cls = classes.find(c => c.id === student.classId);
      addPayment({
        studentId: student.id,
        month: currentMonth,
        amount: cls ? cls.monthlyFee : 0,
        status: 'pending',
        paidDate: null,
        dueDate: `${currentMonth}-01`,
        method: null,
        notes: '',
      });
    }
  });
};
