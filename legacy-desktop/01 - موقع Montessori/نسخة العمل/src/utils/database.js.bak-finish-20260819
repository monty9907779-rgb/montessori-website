// ─── Stats for Dashboard ───────────────────────────────────────────────────
export const getDashboardStats = () => {
  const students = getStudents();
  const payments = getPayments();
  const classes = getClasses();

  const activeStudents = students.filter(s => s.status === 'active').length;
  const totalRevenue = payments.filter(p => p.status === 'paid').reduce((sum, p) => sum + p.amount, 0);
  const pendingAmount = payments.filter(p => p.status === 'pending').reduce((sum, p) => sum + p.amount, 0);
  const overdueStudents = [...new Set(payments.filter(p => p.status === 'pending').map(p => p.studentId))].length;

  // Monthly revenue for chart
  const monthlyRevenue = {};
  payments.filter(p => p.status === 'paid').forEach(p => {
    monthlyRevenue[p.month] = (monthlyRevenue[p.month] || 0) + p.amount;
  });
  const monthlyData = Object.entries(monthlyRevenue).sort().map(([month, revenue]) => ({
    month: new Date(month + '-01').toLocaleDateString('en', { month: 'short', year: '2-digit' }),
    revenue,
  }));

  // Class distribution
  const classData = classes.map(cls => ({
    name: cls.name,
    students: students.filter(s => s.classId === cls.id && s.status === 'active').length,
    color: cls.color,
  }));

  // Collection rate by month
  const allMonths = [...new Set(payments.map(p => p.month))].sort();
  const collectionData = allMonths.map(month => {
    const monthPayments = payments.filter(p => p.month === month);
    const paid = monthPayments.filter(p => p.status === 'paid').length;
    const total = monthPayments.length;
    return {
      month: new Date(month + '-01').toLocaleDateString('en', { month: 'short', year: '2-digit' }),
      rate: total ? Math.round((paid / total) * 100) : 0,
    };
  });

  return { activeStudents, totalRevenue, pendingAmount, overdueStudents, monthlyData, classData, collectionData };
};

