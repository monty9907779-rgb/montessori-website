const ensureUsers = () => {
  const existing = getUsers();
  if (existing.length >= SEED_USERS.length) return;
  const merged = [...existing];
  SEED_USERS.forEach(u => {
    if (!merged.find(m => m.email === u.email)) {
      merged.push({ ...u, id: uid() });
    }
  });
  write(DB_KEYS.USERS, merged);
};

