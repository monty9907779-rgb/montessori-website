function addChips(){
  var wrap=document.createElement('div'); wrap.className='chips';
  KB.filter(function(it){ return it.q && !it.hideChip; }).forEach(function(it){
    var b=document.createElement('button'); b.type='button'; b.textContent=it.q[LANG];
    b.addEventListener('click',function(){ addUser(it.q[LANG].replace(/^[^\s]+\s/,'')); reply(it); });
    wrap.appendChild(b);
  });
  msgs.appendChild(wrap); scrollEnd();
}
function typing(cb){
  var t=document.createElement('div'); t.className='m bot typing'; t.innerHTML='<i></i><i></i><i></i>';
  msgs.appendChild(t); scrollEnd();
  setTimeout(function(){ t.remove(); cb(); }, 450+Math.random()*350);
}
function reply(it){
  typing(function(){
    if(it){ addBot(it.a[LANG], it.act?it.act[LANG]:null, it.wa); }
    else  { addBot(T.fallback, null, true); addChips(); }
  });
}
