function addUser(t){ var d=document.createElement('div'); d.className='m user'; d.textContent=t; msgs.appendChild(d); scrollEnd(); }
function addBot(html,acts,waBtn){
  var d=document.createElement('div'); d.className='m bot'; d.innerHTML=html;
  (acts||[]).forEach(function(a){ d.innerHTML+='<br/><a class="act" href="'+a.h+'" '+(a.h.indexOf('http')===0?'target="_blank" rel="noopener"':'')+'>'+a.t+'</a>'; });
