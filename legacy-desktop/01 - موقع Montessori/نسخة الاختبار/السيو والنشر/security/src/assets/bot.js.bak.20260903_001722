/* ---------- تطبيع النص العربي للمطابقة ---------- */
function norm(s){
  return String(s||'').toLowerCase()
    .replace(/[ً-ْـ]/g,'')
    .replace(/[أإآ]/g,'ا').replace(/ى/g,'ي').replace(/ة/g,'ه')
    .replace(/[^؀-ۿa-z0-9\s]/g,' ')
    .replace(/\s+/g,' ').trim();
}
function match(txt){
  var t=' '+norm(txt)+' ', best=null, bestScore=0;
  KB.forEach(function(it){
    var score=0;
    (it.kw?(it.kw[LANG].concat(it.kw[LANG==='ar'?'en':'ar'])):[]).forEach(function(k){
      if(t.indexOf(' '+norm(k))>=0 || t.indexOf(norm(k))>=0) score+= norm(k).length>3?2:1;
    });
    if(score>bestScore){ bestScore=score; best=it; }
  });
  return bestScore>0?best:null;
}

