{
  "name": "planet-of-the-free-child",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src next.config.mjs tailwind.config.ts postcss.config.mjs scripts --max-warnings=0",
    "type-check": "tsc --noEmit --incremental false",
    "verify:i18n": "node scripts/verify-i18n.js",
    "verify:css": "node scripts/verify-css.js",
    "verify:assets": "node scripts/verify-public-assets.js",
    "test:ci": "npm run lint && npm run type-check && npm run verify:i18n && npm run verify:css && npm run verify:assets && npm run build",
    "security-audit": "npm audit --omit=dev",
    "update-deps": "npm update"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.383.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
